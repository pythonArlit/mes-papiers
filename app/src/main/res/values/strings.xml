    <!-- Configuration initiale -->
    <string name="intro_title">Bienvenue</string>
    <string name="intro_body">Mes Papiers garde tes documents chiffrés sur ce téléphone, sans compte et sans connexion.</string>
    <string name="intro_two_steps_title">Deux étapes pour ouvrir</string>
    <string name="intro_two_steps_body">Tu choisis une phrase secrète, puis tu associes une application d’authentification (Aegis, Google Authenticator, FreeOTP…) qui te donnera un code à six chiffres à chaque ouverture.</string>
    <string name="intro_no_reset_title">Aucune réinitialisation possible</string>
    <string name="intro_no_reset_body">Il n’existe ni code de secours ni « mot de passe oublié ». Si tu oublies ta phrase ou perds ton application d’authentification, la seule solution sera de réinstaller Mes Papiers puis de restaurer une archive de sauvegarde avec ta phrase de récupération. Sans archive ou sans phrase de récupération, tes documents sont perdus.</string>
    <string name="intro_same_device_title">Deux téléphones, c’est mieux</string>
    <string name="intro_same_device_body">Si l’application d’authentification est sur ce même téléphone, une personne qui le tient déverrouillé n’a plus qu’à connaître ta phrase. Pour mieux séparer les deux étapes, installe l’application d’authentification sur un autre appareil.</string>
    <string name="intro_no_lock_title">Ce téléphone n’a pas de verrouillage d’écran</string>
    <string name="intro_no_lock_body">Sans code, schéma ou empreinte, tes documents sont moins bien protégés en cas de perte ou de vol. Active un verrouillage d’écran dans les réglages du téléphone.</string>
    <string name="intro_start">Créer mon coffre</string>

    <string name="create_title">Ta phrase secrète</string>
    <string name="create_body">Au moins 12 caractères. Une suite de mots que toi seul peux retrouver vaut mieux qu’un mot compliqué. Aucune règle de majuscules ou de chiffres.</string>
    <string name="create_field">Phrase secrète</string>
    <string name="create_confirm_field">Répète la phrase</string>
    <string name="create_mismatch">Les deux saisies sont différentes.</string>
    <string name="create_too_short">Il faut au moins 12 caractères.</string>
    <string name="create_preparing">Préparation du coffre : cela peut prendre quelques secondes.</string>
    <string name="strength_label">Robustesse : %1$s</string>
    <string name="strength_too_short">trop courte</string>
    <string name="strength_weak">faible</string>
    <string name="strength_fair">correcte</string>
    <string name="strength_good">bonne</string>
    <string name="strength_strong">très bonne</string>

    <string name="enroll_title">Associe ton application d’authentification</string>
    <string name="enroll_body">Scanne ce code avec l’application d’authentification d’un autre appareil. Si elle est sur ce téléphone, utilise le bouton ou recopie la clé.</string>
    <string name="enroll_qr_description">Code QR d’association</string>
    <string name="enroll_open_app">Ouvrir dans mon application d’authentification</string>
    <string name="enroll_no_app">Aucune application d’authentification n’a été trouvée sur ce téléphone.</string>
    <string name="enroll_manual_key">Clé à saisir à la main</string>
    <string name="enroll_issuer_hint">Nom du compte : Mes Papiers · code à 6 chiffres · 30 secondes</string>
    <string name="enroll_code_field">Code à six chiffres</string>
    <string name="enroll_confirm">Vérifier et terminer</string>
    <string name="enroll_warning">Après cette étape, la clé ne sera plus jamais affichée.</string>

