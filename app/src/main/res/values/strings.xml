    <string name="vault_unreadable_title">Coffre illisible</string>
    <string name="vault_unreadable">Le coffre de ce téléphone n’est plus lisible : sa clé de protection a disparu ou ses fichiers sont abîmés. Ta phrase secrète ne suffit plus. Réinstalle l’application puis restaure ta dernière archive avec ta phrase de récupération.</string>

    <!-- Variante de démonstration -->
    <string name="demo_single_step_title">Démo : une seule étape</string>
    <string name="demo_single_step_body">Dans cette version de démonstration, le code de l’application d’authentification n’est pas demandé : seule ta phrase secrète ouvre le coffre. La protection est donc réduite. N’y range aucun document réel.</string>
